{
  "name": "template-react-ts",
  "description": "A Phaser 3 TypeScript project template that demonstrates React communication and uses Vite for bundling.",
  "version": "1.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-react-ts.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-react-ts/issues"
  },
  "homepage": "https://github.com/phaserjs/template-react-ts#readme",
  "keywords": [
    "phaser",
    "phaser3",
    "react",
    "vite",
    "typescript"
  ],
  "scripts": {
    "dev": "concurrently \"node log.js dev\" \"vite --config vite/config.dev.mjs --host 0.0.0.0\"",
    "build": "concurrently \"node log.js build\" \"vite build --config vite/config.prod.mjs\"",
    "build:offline": "vite build --config vite/config.offline.mjs",
    "verify:offline": "node scripts/verify-offline.mjs dist-offline/index.html",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "playwright": "^1.63.0",
    "terser": "^5.28.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}
